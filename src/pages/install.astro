---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ShellBlock from "~/components/ShellBlock.astro";
import InstallCard from "~/components/InstallCard.astro";
import OsTabs from "~/components/OsTabs.astro";
import LatestRelease from "~/components/LatestRelease.astro";
import { REPO, latestRelease } from "~/data/site";

const release = await latestRelease();

const quickInstall = `brew tap kexhq/tey
brew install kexhq/tey/tey
tey kex install`;

const docker = `docker run --rm ghcr.io/kexhq/kex:latest kex --version`;

const teyCommands = `tey kex list                 # every version you can get
tey kex install 0.3.0-beta   # get a specific one
tey kex use 0.3.0-beta       # switch to it`;

const clone = `git clone ${REPO}.git
cd kex`;

const macDeps = `brew install cmake gmp pcre2 boost readline`;

const debDeps = `sudo apt install cmake libgmp-dev libpcre2-dev libboost-context-dev libreadline-dev`;

const build = `make build          # produces ./build/kex`;

const run = `make run F=examples/fizzbuzz.kex
make repl                       # drop into the REPL
build/kex examples/vectors_advanced.kex`;

const installBin = `sudo make install              # /usr/local/bin/kex
make install PREFIX=$HOME/.local   # install elsewhere`;

const ICONS = {
  brew: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>',
  docker:
    '<path d="M4 6h16v12H4z"/><path d="M8 6V4h8v2"/><rect x="8" y="10" width="2" height="2"/><rect x="12" y="10" width="2" height="2"/><rect x="16" y="10" width="2" height="2"/><rect x="8" y="14" width="2" height="2"/><rect x="12" y="14" width="2" height="2"/><rect x="16" y="14" width="2" height="2"/>',
};

const CODE =
  "rounded-md border border-[var(--color-line)] bg-[var(--color-bg-muted)] px-[0.4rem] py-[0.12rem] font-mono text-[13px] text-[var(--color-ink)]";
---

<BaseLayout
  title="Installation | Kex"
  description="Install the kex compiler with Homebrew via Tey, run it in Docker, or build from source."
>
  <section
    class="border-b border-[var(--color-line)] bg-[var(--color-bg-subtle)]"
  >
    <div class="container-page py-14">
      <h1
        class="text-[28px] font-semibold tracking-[-0.02em] text-[var(--color-ink)] sm:text-[32px]"
      >
        Install Kex
      </h1>
      <p
        class="mt-3 max-w-2xl text-[16px] leading-relaxed text-[var(--color-muted)]"
      >
        Three commands with Homebrew and you're running the latest release.
        Prefer Docker or building from source? Those work too.
      </p>
      <p class="mt-3 font-mono text-[12.5px] text-[var(--color-faint)]">
        latest stable:
        <a
          href={release.url}
          data-release-tag
          data-release-url
          class="text-[var(--color-accent-strong)] hover:underline"
        >
          {release.tag}
        </a>
      </p>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="max-w-4xl">
      <div class="grid gap-6 md:grid-cols-2">
        <InstallCard
          title="Homebrew"
          icon={ICONS.brew}
          description="Sets up Tey, which installs and manages Kex versions. macOS and Linux."
          code={quickInstall}
          tag="Recommended"
          tagClass="bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)]"
        />

        <InstallCard
          title="Docker"
          icon={ICONS.docker}
          description="No install. Runs Kex in a container you throw away after."
          code={docker}
          codeLabel="docker"
          tag="Container"
          tagClass="bg-[var(--color-bg-muted)] text-[var(--color-muted)]"
        />
      </div>

      <div
        class="mt-12 rounded-2xl border border-[var(--color-line)] bg-[var(--color-bg-subtle)] p-8"
      >
        <h2
          class="text-[17px] font-semibold tracking-[-0.01em] text-[var(--color-ink)]"
        >
          Need a different version?
        </h2>
        <p class="mt-2 text-[14px] text-[var(--color-muted)]">
          The brew install above includes <strong>Tey</strong>, which swaps Kex
          versions for you:
        </p>
        <div class="mt-5">
          <ShellBlock code={teyCommands} />
        </div>
        <p class="mt-4 text-[14px] text-[var(--color-muted)]">
          <code class={CODE}>tey kex install</code> alone gets
          you the newest stable release;
          <code class={CODE}>tey kex install --pre</code> gets
          pre-releases.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-line)] bg-[var(--color-bg-subtle)]">
    <div class="container-page py-10">
      <div class="max-w-4xl">
        <details class="group">
          <summary
            class="flex cursor-pointer items-start justify-between gap-4 list-none"
          >
            <div>
              <h2
                class="text-[22px] font-semibold tracking-[-0.02em] text-[var(--color-ink)]"
              >
                Build from source
              </h2>
              <p
                class="mt-2 max-w-2xl text-[15px] leading-relaxed text-[var(--color-muted)]"
              >
                For contributors, packagers, or anyone who prefers a self-built
                binary. Most users should use Homebrew or Docker above.
              </p>
            </div>
            <span
              class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[var(--color-line)] bg-[var(--color-bg)] text-[var(--color-muted)] transition-transform duration-200 group-open:rotate-180"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </span>
          </summary>

          <div class="relative mt-8">
            <div
              class="absolute left-[13px] top-3 bottom-3 w-px bg-[var(--color-line)]"
              aria-hidden="true"
            >
            </div>
            <div class="space-y-8">
              <div class="relative flex gap-5">
                <span
                  class="relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-soft)] font-mono text-[13px] font-semibold text-[var(--color-accent-strong)]"
                  >1</span
                >
                <div class="flex-1 space-y-2">
                  <h3
                    class="text-[16px] font-semibold tracking-[-0.01em] text-[var(--color-ink)]"
                  >
                    Clone the repo
                  </h3>
                  <ShellBlock code={clone} />
                </div>
              </div>

              <div class="relative flex gap-5">
                <span
                  class="relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-soft)] font-mono text-[13px] font-semibold text-[var(--color-accent-strong)]"
                  >2</span
                >
                <div class="flex-1 space-y-2">
                  <h3
                    class="text-[16px] font-semibold tracking-[-0.01em] text-[var(--color-ink)]"
                  >
                    Install dependencies
                  </h3>
                  <OsTabs
                    tabs={[
                      { id: "mac", label: "macOS", code: macDeps },
                      { id: "deb", label: "Debian / Ubuntu", code: debDeps },
                    ]}
                  />
                </div>
              </div>

              <div class="relative flex gap-5">
                <span
                  class="relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-soft)] font-mono text-[13px] font-semibold text-[var(--color-accent-strong)]"
                  >3</span
                >
                <div class="flex-1 space-y-2">
                  <h3
                    class="text-[16px] font-semibold tracking-[-0.01em] text-[var(--color-ink)]"
                  >
                    Build
                  </h3>
                  <ShellBlock code={build} />
                </div>
              </div>

              <div class="relative flex gap-5">
                <span
                  class="relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-soft)] font-mono text-[13px] font-semibold text-[var(--color-accent-strong)]"
                  >4</span
                >
                <div class="flex-1 space-y-2">
                  <h3
                    class="text-[16px] font-semibold tracking-[-0.01em] text-[var(--color-ink)]"
                  >
                    Run it
                  </h3>
                  <ShellBlock code={run} />
                </div>
              </div>

              <div class="relative flex gap-5">
                <span
                  class="relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-soft)] font-mono text-[13px] font-semibold text-[var(--color-accent-strong)]"
                  >5</span
                >
                <div class="flex-1 space-y-2">
                  <h3
                    class="text-[16px] font-semibold tracking-[-0.01em] text-[var(--color-ink)]"
                  >
                    Install the binary (optional)
                  </h3>
                  <p class="text-[14px] text-[var(--color-muted)]">
                    Copies the built binary and standard library to a path on
                    your <code class={CODE}>PATH</code>. It intentionally does
                    not build as root.
                  </p>
                  <ShellBlock code={installBin} />
                </div>
              </div>
            </div>
          </div>

          <div class="mt-12">
            <div
              class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-bg)] p-6"
            >
              <h3
                class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-faint)]"
              >
                Make targets
              </h3>
              <ul
                class="mt-4 grid gap-x-8 gap-y-2 font-mono text-[13px] sm:grid-cols-2"
              >
                {
                  [
                    ["make build", "build the compiler"],
                    ["make run F=", "run a .kex file"],
                    ["make repl", "start the REPL"],
                    ["make test", "C++ unit tests"],
                    ["make spec", "language specs"],
                    ["make check F=", "semantic analysis only"],
                    ["make parse", "parse all examples"],
                    ["make clean", "remove build artifacts"],
                  ].map(([cmd, desc]) => (
                    <li class="flex flex-col gap-0.5 border-b border-[var(--color-line)] py-2">
                      <span class="text-[var(--color-accent-strong)]">
                        {cmd}
                      </span>
                      <span class="font-sans text-[12.5px] text-[var(--color-muted)]">
                        {desc}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </details>
      </div>
    </div>
  </section>
  <LatestRelease />
</BaseLayout>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
