---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import { REPO } from "~/data/site";

interface Props {
  title?: string;
  description?: string;
  /** hide the chrome (nav/footer) — used for focused surfaces later */
  bare?: boolean;
  ogImage?: string;
}

const {
  title = "Kex Programming Language",
  description = "Pragmatically functional language for the BEAM VM and more",
  bare = false,
  ogImage = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const home = new URL("/", Astro.site).toString();

// Schema.org for search engines: the site itself on every page, and on the
// home page the language it is about.
const structured = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      name: "Kex",
      url: home,
      inLanguage: "en",
    },
    ...(Astro.url.pathname === "/"
      ? [
          {
            "@type": "ComputerLanguage",
            name: "Kex",
            url: home,
            description,
            sameAs: [REPO],
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kex.run" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A biscuit with a K bitten out of its corner, beside the words Kex programming language."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <meta name="theme-color" content="#fcf5e2" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen bg-[var(--color-bg)]">
    {!bare && <Nav />}

    <main>
      <slot />
    </main>

    {!bare && <Footer />}
  </body>
</html>
