---
interface Tab {
  id: string;
  label: string;
  code: string;
}

interface Props {
  tabs: Tab[];
  /** Accessible label for the tablist (defaults to "Platform"). */
  label?: string;
}

const { tabs, label = "Platform" } = Astro.props;
const initial = tabs[0];
const panelId = `os-panel-${crypto.randomUUID()}`;
---

<div
  class="os-tabs surface-code overflow-hidden rounded-xl border border-[var(--color-code-border)] shadow-[0_18px_40px_-24px_rgba(13,12,40,0.45)]"
  data-os-tabs
>
  <div
    class="flex items-center gap-3 border-b border-[var(--color-code-border)] bg-[var(--color-code-bg-soft)] px-4 py-2.5"
  >
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    </span>
    <div role="tablist" aria-label={label} class="flex gap-1">
      {
        tabs.map((tab) => (
          <button
            type="button"
            role="tab"
            aria-selected={tab.id === initial.id ? "true" : "false"}
            aria-controls={panelId}
            data-os-tab={tab.id}
            data-os-code={tab.code}
            class="px-2 py-1.5 font-mono text-[12px] text-[#8a8aa0] transition-colors hover:text-[#e6e6f0] aria-selected:border-b-2 aria-selected:border-[var(--color-accent)] aria-selected:text-[#e6e6f0]"
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    <div class="ml-auto flex items-center gap-1.5">
      <button
        type="button"
        data-copy
        class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 font-mono text-[11px] text-[#9a9ab0] transition hover:bg-white/5 hover:text-[#e6e6f0]"
        aria-label="Copy code"
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span data-copy-label>Copy</span>
      </button>
    </div>
  </div>

  <pre
    class="scroll-slim overflow-x-auto px-4 py-4 text-[14px] leading-[1.7] sm:px-5"
  >
    <code id={panelId} data-os-panel role="tabpanel">{initial.code.replace(/\n$/, "")}</code>
  </pre>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll("[data-os-tabs]").forEach((root) => {
      const code = root.querySelector("[data-os-panel]");
      const copyBtn = root.querySelector("[data-copy]");
      const tabs = root.querySelectorAll("[data-os-tab]");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => t.setAttribute("aria-selected", "false"));
          tab.setAttribute("aria-selected", "true");
          if (code) {
            const text = tab.getAttribute("data-os-code") || "";
            code.textContent = text.replace(/\n$/, "");
          }
        });
      });

      copyBtn?.addEventListener("click", () => {
        const text = code?.textContent || "";
        navigator.clipboard?.writeText(text).then(() => {
          const label = copyBtn.querySelector("[data-copy-label]");
          const prev = label?.textContent;
          if (label) label.textContent = "Copied";
          setTimeout(() => {
            if (label && prev) label.textContent = prev;
          }, 1400);
        });
      });
    });
  })();
</script>
