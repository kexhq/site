---
import ShellBlock from "./ShellBlock.astro";

interface Props {
  title: string;
  icon: string;
  description: string;
  code: string;
  codeLabel?: string;
  tag?: string;
  tagClass?: string;
}

const {
  title,
  icon,
  description,
  code,
  codeLabel = "shell",
  tag,
  tagClass = "bg-[var(--color-bg-muted)] text-[var(--color-muted)]",
} = Astro.props;
---

<div
  class="group flex min-w-0 flex-col rounded-2xl border border-[var(--color-line)] bg-[var(--color-bg)] p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--color-line-strong)] hover:shadow-[0_18px_40px_-26px_rgba(13,12,40,0.35)]"
>
  <div class="mb-4 flex items-start justify-between gap-3">
    <div class="flex items-center gap-3">
      <div
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-accent-soft)] text-[var(--color-accent-strong)] transition-colors group-hover:bg-[var(--color-accent)] group-hover:text-white"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icon}
        />
      </div>
      <h2
        class="text-[17px] font-semibold tracking-[-0.01em] text-[var(--color-ink)]"
      >
        {title}
      </h2>
    </div>
    {
      tag && (
        <span
          class:list={[
            "shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider",
            tagClass,
          ]}
        >
          {tag}
        </span>
      )
    }
  </div>

  <p class="mb-5 text-[14px] leading-relaxed text-[var(--color-muted)]">
    {description}
  </p>

  <div class="mt-auto">
    <ShellBlock code={code} label={codeLabel} />
  </div>
</div>
