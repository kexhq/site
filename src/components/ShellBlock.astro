---
interface Props {
  code: string;
  /** Label shown in the code window toolbar (defaults to "shell"). */
  label?: string;
  /** Show a filename pill instead of the language label. */
  file?: string;
}

const { code, label = "shell", file } = Astro.props;
const title = file ?? label;
const trimmed = code.replace(/\n$/, "");
---

<figure
  class="group surface-code relative overflow-hidden rounded-xl border border-[var(--color-code-border)] shadow-[0_18px_40px_-24px_rgba(13,12,40,0.45)]"
>
  <div
    class="flex items-center gap-3 border-b border-[var(--color-code-border)] bg-[var(--color-code-bg-soft)] px-4 py-2.5"
  >
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    </span>
    {title && (
      <span class="font-mono text-[12px] text-[#8a8aa0]">{title}</span>
    )}
    <div class="ml-auto flex items-center gap-1.5">
      <button
        type="button"
        data-copy
        class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 font-mono text-[11px] text-[#9a9ab0] transition hover:bg-white/5 hover:text-[#e6e6f0]"
        aria-label="Copy code"
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span data-copy-label>Copy</span>
      </button>
    </div>
  </div>

  <div class="relative">
    <pre
      class="scroll-slim overflow-x-auto px-4 py-4 text-[14px] leading-[1.7] sm:px-5"
    ><code>{trimmed}</code></pre>
  </div>
</figure>

<script is:inline>
  // Dependency-free copy-to-clipboard wiring. The guard prevents duplicate
  // listeners when several ShellBlock components live on the same page.
  if (!window.__kexShellWired) {
    window.__kexShellWired = true;

    document.addEventListener("click", (e) => {
      const btn = e.target?.closest?.("[data-copy]");
      if (!btn) return;
      const figure = btn.closest("figure");
      const pre = figure?.querySelector("pre code");
      if (!pre) return;
      const text = pre.innerText;
      navigator.clipboard?.writeText(text).then(() => {
        const label = btn.querySelector("[data-copy-label]");
        const prev = label?.textContent;
        if (label) label.textContent = "Copied";
        setTimeout(() => {
          if (label && prev) label.textContent = prev;
        }, 1400);
      });
    });
  }
</script>
