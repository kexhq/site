---
import { highlightKex } from "~/lib/highlight";
import { repoBlob } from "~/data/site";
import { playgroundHref } from "~/lib/share";

interface Props {
  code: string;
  title?: string;
  /** Show a faux window filename pill instead of a raw label. */
  file?: string;
  /** Repo-relative path (e.g. "examples/hello.kex"). When given, renders a "View on GitHub" link below the code. */
  source?: string;
  /** Optional small caption rendered under the code. */
  caption?: string;
  /** Remove left padding indent for inline-ish blocks. */
  compact?: boolean;
  /** Hide the top toolbar entirely. */
  bare?: boolean;
  /** Render an output pane below the code (Kex program stdout). */
  output?: string;
  repl?: boolean;
  /**
   * If set, renders an "Open in Playground" link (opens in a new tab) that
   * loads this code into the playground via a share-style URL.
   *
   * Accepts either a bare string (code only) or `{ code, name }` to also
   * embed a filename in the URL — the playground uses it as the tab name
   * on the receiving side, so example links open as `fact.kex` rather than
   * the generic "Shared".
   *
   * Defaults ON: when undefined, the link targets the displayed `code` and
   * derives a name from the current page's URL slug (so `/docs/functions/`
   * becomes `functions.kex`). Pass `null` to explicitly disable.
   */
  openInPlayground?: string | { code: string; name?: string } | null;
}

const {
  code,
  title,
  file,
  source,
  caption,
  compact,
  bare,
  output,
  repl,
  openInPlayground,
} = Astro.props;

const highlighted = highlightKex(code.replace(/\n$/, ""));
const hasOutput = typeof output === "string" && output.trim().length > 0;
const hasTop = bare || !repl;
const label = file ?? title;

// Derive a default `.kex` filename from the current page's URL slug —
// `/docs/functions/` becomes `functions.kex`. Falls back to `snippet.kex`
// for the root page or unusual paths. Used only when the caller didn't
// explicitly pass `openInPlayground` with its own name.
const pageSlug =
  Astro.url.pathname.split("/").filter(Boolean).pop() ?? "snippet";
const defaultPlaygroundName = `${pageSlug}.kex`;

// Normalize the openInPlayground prop into { code, name? } so the link builder
// only has one shape to deal with. Bare strings still work for back-compat.
// When the prop is undefined (the common case), default to encoding the
// displayed snippet under the page-derived name so every Code block on the
// docs "just works" without each call site having to opt in. Pass `null`
// explicitly to suppress the link.
let playgroundTarget: { code: string; name?: string } | null;
if (openInPlayground === null) {
  playgroundTarget = null;
} else if (typeof openInPlayground === "string") {
  playgroundTarget = { code: openInPlayground };
} else if (openInPlayground) {
  playgroundTarget = openInPlayground;
} else {
  playgroundTarget = { code, name: defaultPlaygroundName };
}
const playgroundLink =
  playgroundTarget && playgroundTarget.code.length > 0
    ? playgroundHref(playgroundTarget.code, playgroundTarget.name)
    : null;
---

<figure
  class:list={[
    "group surface-code relative mt-5 overflow-hidden rounded-xl border border-[var(--color-code-border)] shadow-[0_18px_40px_-24px_rgba(13,12,40,0.45)]",
    repl ? "mb-2" : "mb-5",
  ]}
>
  {
    hasTop && (
      <div class="flex items-center gap-3 border-b border-[var(--color-code-border)] bg-[var(--color-code-bg-soft)] px-4 py-2.5">
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]" />
          <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]" />
          <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]" />
        </span>
        {label && (
          <span class="font-mono text-[12px] text-[#8a8aa0]">{label}</span>
        )}
        <div class="ml-auto flex items-center gap-1.5">
          {playgroundLink && (
            <a
              href={playgroundLink}
              target="_blank"
              rel="noopener"
              class="hidden items-center gap-1 rounded-md px-2 py-1 font-mono text-[11px] text-[#e6c178] transition hover:bg-white/5 hover:text-[#f0d4a0] sm:inline-flex"
              aria-label="Open in Playground"
              title="Open in Playground"
            >
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
              Playground
            </a>
          )}
          <button
            type="button"
            data-copy
            data-copy-target="next-code-block"
            class="hidden items-center gap-1.5 rounded-md px-2 py-1 font-mono text-[11px] text-[#9a9ab0] transition hover:bg-white/5 hover:text-[#e6e6f0] sm:inline-flex"
            aria-label="Copy code"
          >
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <>
                <rect x="9" y="9" width="13" height="13" rx="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </>
            </svg>
            <span data-copy-label>Copy</span>
          </button>
        </div>
      </div>
    )
  }

  <div class="relative">
    <pre
      class:list={[
        "scroll-slim overflow-x-auto px-4 py-4 text-[14px] leading-[1.7]",
        !compact && "sm:px-5",
      ]}><code set:html={highlighted} /></pre>
  </div>

  {
    hasOutput && (
      <div class="border-t border-[var(--color-code-border)] bg-[var(--color-code-bg-soft)]">
        <div class="px-4 pt-2.5 font-mono text-[10.5px] uppercase tracking-[0.12em] text-[#6b6b80]">
          stdout
        </div>
        <pre class="scroll-slim overflow-x-auto px-4 pb-3 pt-1 font-mono text-[13px] leading-[1.6] text-[#9ad6a0]"><code>{output.replace(/\n$/, "")}</code></pre>
      </div>
    )
  }
</figure>

{
  source && (
    <a
      href={repoBlob(source)}
      target="_blank"
      rel="noreferrer"
      class="-mt-3 mb-5 ml-5 inline-flex items-center gap-1.5 font-mono text-[12.5px] text-[var(--color-accent-strong)] hover:underline"
    >
      {source}
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17L17 7M9 7h8v8" />
      </svg>
    </a>
  )
}

{
  caption && (
    <figcaption class="-mt-2 mb-5 text-center text-[13px] text-[var(--color-faint)]">
      {caption}
    </figcaption>
  )
}

{
  repl && (
    <p class="mb-5 flex items-center justify-end gap-2 text-[13px] text-[var(--color-faint)]">
      <button
        type="button"
        data-paste-to-repl
        class="inline-flex items-center gap-1 rounded-md bg-[var(--color-accent-soft)] px-2 py-0.5 font-mono text-[10px] font-medium text-[var(--color-accent-ink)] transition hover:bg-[var(--color-line-strong)]"
        aria-label="Paste to REPL"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
        Paste to REPL
      </button>

      {playgroundLink && (
        <a
          href={playgroundLink}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 rounded-md bg-[var(--color-accent-soft)] px-2 py-0.5 font-mono text-[10px] font-medium text-[var(--color-accent-ink)] transition hover:bg-[var(--color-line-strong)]"
          aria-label="Open in Playground"
        >
          <svg
            width="11"
            height="11"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
          Playground
        </a>
      )}

      <button
        type="button"
        data-copy
        class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 font-mono text-[10px] text-[var(--color-faint)] transition hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-ink-soft)]"
        aria-label="Copy code"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <span data-copy-label>Copy</span>
      </button>
    </p>
  )
}

<script is:inline>
  // This script is inlined verbatim for every <Code> usage on the page (Astro
  // doesn't dedupe is:inline scripts), so guard against wiring the same
  // document-level listeners multiple times — otherwise one click fires once
  // per Code block on the page.
  if (!window.__kexCodeWired) {
    window.__kexCodeWired = true;

    // Tiny, dependency-free copy-to-clipboard wiring.
    document.addEventListener("click", (e) => {
      const btn = e.target?.closest?.("[data-copy]");
      if (!btn) return;
      const figure = btn.closest("figure");
      const pre = figure?.querySelector("pre code");
      if (!pre) return;
      const text = pre.innerText;
      navigator.clipboard?.writeText(text).then(() => {
        const label = btn.querySelector("[data-copy-label]");
        const prev = label?.textContent;
        if (label) label.textContent = "Copied";
        setTimeout(() => {
          if (label && prev) label.textContent = prev;
        }, 1400);
      });
    });

    // "Paste to REPL" hands the code block's text to the live terminal. The
    // button sits in a <p> that immediately follows the <figure> it belongs
    // to (with an optional source link / caption in between), all emitted by
    // the same Code.astro call site.
    document.addEventListener("click", (e) => {
      const btn = e.target?.closest?.("[data-paste-to-repl]");
      if (!btn) return;
      let node = btn.closest("p")?.previousElementSibling;
      while (node && node.tagName !== "FIGURE") node = node.previousElementSibling;
      const text = node?.querySelector("pre code")?.innerText;
      if (!text) return;
      document.dispatchEvent(
        new CustomEvent("kex-repl:paste", { detail: { code: text } }),
      );
    });
  }
</script>
